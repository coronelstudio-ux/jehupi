# Modelo de los secretos de la app. NO subir el archivo real a GitHub.
# En Streamlit Cloud: la app → Settings → Secrets → pegar este contenido con los valores reales.
# Para probar en una PC: copiar como .streamlit/secrets.toml (ya está excluido en .gitignore).

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Reemplazar [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API.
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
# Clave "service_role" (secreta: solo va aquí, nunca en el código).
SUPABASE_SERVICE_KEY = ""
SUPABASE_BUCKET = "facturas"

# IA: "gemini" o "claude".
PROVEEDOR_IA = "gemini"

# Gemini → https://aistudio.google.com (Get API key).
GEMINI_API_KEY = ""
# Verificar en AI Studio el nombre del modelo vigente (el de abajo es un ejemplo).
GEMINI_MODELO = "gemini-3.8-flash"

# Claude (opcional) → https://console.anthropic.com
ANTHROPIC_API_KEY = ""
CLAUDE_MODELO = "claude-opus-5-5"
CLAUDE_ESFUERZO = "medium"

# Páginas que se envían a la IA al mismo tiempo (el plan gratuito de Gemini limita las solicitudes por minuto).
HILOS_PARALELOS = "2"
